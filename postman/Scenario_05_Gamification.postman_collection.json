        },
        "description": "Classement de l'équipe/organisation"
      },
      "response": []
    },
    {
      "name": "08. Créer Badge Personnalisé",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Custom badge created\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.nom).to.eql('Expert Ransomware');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_superadmin}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nom\": \"Expert Ransomware\",\n  \"description\": \"Maîtrise complète de la prévention des ransomwares\",\n  \"type\": \"or\",\n  \"categorie\": \"expertise\",\n  \"icone\": \"🛡️\",\n  \"points_requis\": 500,\n  \"points_attribues\": 100,\n  \"est_secret\": false,\n  \"conditions_obtention\": {\n    \"modules_ransomware_completes\": 3,\n    \"simulations_ransomware_reussies\": 5\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}{{apiPrefix}}/gamification/badges",
          "host": ["{{baseUrl}}"],
          "path": ["{{apiPrefix}}", "gamification", "badges"]
        },
        "description": "Création d'un badge personnalisé"
      },
      "response": []
    },
    {
      "name": "09. Statistiques Gamification",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Gamification stats returned\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('total_points_distribues');",
              "    pm.expect(jsonData).to.have.property('total_badges_obtenus');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
