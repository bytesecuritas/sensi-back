              "    pm.expect(jsonData).to.have.property('disponibles');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_user}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}{{apiPrefix}}/gamification/badges/user",
          "host": ["{{baseUrl}}"],
          "path": ["{{apiPrefix}}", "gamification", "badges", "user"]
        },
        "description": "Badges obtenus et disponibles pour l'utilisateur"
      },
      "response": []
    },
