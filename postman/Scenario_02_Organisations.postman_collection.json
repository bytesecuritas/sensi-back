    {
      "name": "08. Recherche Organisations par Type",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Filtered by type\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "    jsonData.forEach(function(org) {",
              "        pm.expect(org.type).to.eql('entreprise_privee');",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_superadmin}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}{{apiPrefix}}/organisations?type=entreprise_privee",
          "host": ["{{baseUrl}}"],
          "path": ["{{apiPrefix}}", "organisations"],
          "query": [
            {
              "key": "type",
              "value": "entreprise_privee"
            }
          ]
        },
        "description": "Filtrage des organisations par type"
      },
      "response": []
    },
    {
      "name": "09. Recherche Organisations par Pays",
      "event": [
        {
