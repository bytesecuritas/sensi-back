              "",
              "pm.test(\"Hospital created\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.nom).to.eql('CHU Marseille');",
              "    pm.environment.set('organisation_id_3', jsonData.organisation_id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_superadmin}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nom\": \"CHU Marseille\",\n  \"type\": \"organisme_sante\",\n  \"code_pays\": \"FR\",\n  \"email\": \"contact@chu-marseille.fr\",\n  \"telephone\": \"+33491384000\",\n  \"adresse\": \"264 Rue Saint-Pierre\",\n  \"ville\": \"Marseille\",\n  \"code_postal\": \"13005\",\n  \"pays\": \"France\",\n  \"site_web\": \"https://chu-marseille.fr\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}{{apiPrefix}}/organisations",
          "host": ["{{baseUrl}}"],
          "path": ["{{apiPrefix}}", "organisations"]
        },
        "description": "Création d'une organisation de santé"
      },
      "response": []
    },
    {
      "name": "05. Mise à Jour Organisation TechCorp",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Organisation updated\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.telephone).to.eql('+33199887766');",
              "});"
