        ],
        "url": {
          "raw": "{{baseUrl}}{{apiPrefix}}/organisations/{{organisation_id}}/users",
          "host": ["{{baseUrl}}"],
          "path": ["{{apiPrefix}}", "organisations", "{{organisation_id}}", "users"]
        },
        "description": "Liste des utilisateurs d'une organisation"
      },
      "response": []
