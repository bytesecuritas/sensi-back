{
  "info": {
    "name": "Scénario 02 - Gestion des Organisations",
    "description": "Tests CRUD complets des organisations : création, lecture, mise à jour, suppression, statistiques",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. Liste des Organisations",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response is an array\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "    pm.expect(jsonData.length).to.be.at.least(1);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_superadmin}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}{{apiPrefix}}/organisations",
          "host": ["{{baseUrl}}"],
          "path": ["{{apiPrefix}}", "organisations"]
        },
        "description": "Récupération de toutes les organisations"
      },
      "response": []
    },
    {
      "name": "02. Détails Organisation TechCorp",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Organisation details correct\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.nom).to.eql('TechCorp Solutions');",
              "    pm.expect(jsonData.type).to.eql('entreprise_privee');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_superadmin}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}{{apiPrefix}}/organisations/{{organisation_id}}",
          "host": ["{{baseUrl}}"],
          "path": ["{{apiPrefix}}", "organisations", "{{organisation_id}}"]
        },
        "description": "Récupération des détails d'une organisation"
      },
      "response": []
    },
    {
      "name": "03. Créer Organisation SecureBank",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"SecureBank created\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.nom).to.eql('SecureBank France');",
              "    pm.environment.set('organisation_id_2', jsonData.organisation_id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_superadmin}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nom\": \"SecureBank France\",\n  \"type\": \"institution_financiere\",\n  \"code_pays\": \"FR\",\n  \"email\": \"contact@securebank.fr\",\n  \"telephone\": \"+33987654321\",\n  \"adresse\": \"45 Rue de la Banque\",\n  \"ville\": \"Lyon\",\n  \"code_postal\": \"69002\",\n  \"pays\": \"France\",\n  \"site_web\": \"https://securebank.fr\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}{{apiPrefix}}/organisations",
          "host": ["{{baseUrl}}"],
          "path": ["{{apiPrefix}}", "organisations"]
        },
        "description": "Création d'une deuxième organisation"
      },
      "response": []
    },
