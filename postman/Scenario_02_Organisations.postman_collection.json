    {
      "name": "06. Statistiques Organisation TechCorp",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Statistics have required fields\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('total_utilisateurs');",
              "    pm.expect(jsonData).to.have.property('utilisateurs_actifs');",
              "    pm.expect(jsonData).to.have.property('parcours_assignes');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_superadmin}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}{{apiPrefix}}/organisations/{{organisation_id}}/stats",
          "host": ["{{baseUrl}}"],
          "path": ["{{apiPrefix}}", "organisations", "{{organisation_id}}", "stats"]
        },
        "description": "Récupération des statistiques d'une organisation"
      },
      "response": []
    },
