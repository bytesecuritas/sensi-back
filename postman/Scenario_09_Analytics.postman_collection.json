{
  "info": {
    "name": "Scénario 09 - Analytics et Rapports",
    "description": "Tests des analytics : dashboard global, rapports organisations, tendances, exports",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. Dashboard Global",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Dashboard data returned\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('total_utilisateurs');",
              "    pm.expect(jsonData).to.have.property('total_organisations');",
              "    pm.expect(jsonData).to.have.property('total_parcours');",
              "    pm.expect(jsonData).to.have.property('total_certifications');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_superadmin}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}{{apiPrefix}}/analytics/dashboard?timeRange=MONTH",
          "host": ["{{baseUrl}}"],
          "path": ["{{apiPrefix}}", "analytics", "dashboard"],
          "query": [
            {
              "key": "timeRange",
              "value": "MONTH"
            }
          ]
        },
        "description": "Dashboard global des analytics (superadmin)"
      },
      "response": []
    },
