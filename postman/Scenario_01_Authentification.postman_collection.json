{
  "info": {
    "name": "Scénario 01 - Authentification et Gestion Utilisateurs",
    "description": "Tests complets de l'authentification : création superadmin, admin, user, login, profil, changement mot de passe, réinitialisation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. Créer Superadmin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response has user data\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('users_id');",
              "    pm.expect(jsonData.role).to.eql('superadmin');",
              "    pm.expect(jsonData.email).to.eql('superadmin@cybersec.com');",
              "    pm.environment.set('superadmin_id', jsonData.users_id);",
              "});",
              "",
              "pm.test(\"Password is not in response\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.not.have.property('password');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"superadmin@cybersec.com\",\n  \"password\": \"SuperAdmin123!@#\",\n  \"nom\": \"Super\",\n  \"prenom\": \"Admin\",\n  \"age\": 35,\n  \"role\": \"superadmin\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}{{apiPrefix}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["{{apiPrefix}}", "auth", "register"]
        },
        "description": "Création du premier superadmin de la plateforme"
      },
      "response": []
    },
