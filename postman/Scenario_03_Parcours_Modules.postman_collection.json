          "raw": "{\n  \"titre\": \"Reconnaître les Emails de Phishing\",\n  \"description\": \"Apprendre à identifier les emails frauduleux et les tentatives de phishing\",\n  \"parcours_id\": {{parcours_id}},\n  \"public_cible\": \"tous\",\n  \"code_langue\": \"FR\",\n  \"niveau_difficulte\": \"facile\",\n  \"thematique_cyber\": \"phishing\",\n  \"ordre\": 1,\n  \"objectifs_apprentissage\": [\n    \"Identifier les emails suspects\",\n    \"Connaître les bonnes pratiques\",\n    \"Savoir réagir face à un email de phishing\"\n  ],\n  \"points_completion\": 50,\n  \"points_quiz_reussi\": 25,\n  \"badge_associe_id\": null,\n  \"simulation_requise\": false\n}"
        },
