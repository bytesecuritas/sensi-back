{
  "info": {
    "name": "Scénario 03 - Parcours et Modules d'Apprentissage",
    "description": "Tests CRUD des parcours d'apprentissage, modules, contenus média, assignation aux organisations",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. Créer Parcours Débutant",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Parcours created\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('parcours_id');",
              "    pm.expect(jsonData.titre).to.eql('Sensibilisation Cybersécurité - Niveau Débutant');",
              "    pm.environment.set('parcours_id', jsonData.parcours_id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_superadmin}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titre\": \"Sensibilisation Cybersécurité - Niveau Débutant\",\n  \"description\": \"Parcours d'introduction à la cybersécurité pour tous les collaborateurs\",\n  \"public_cible\": \"entreprise\",\n  \"duree_estimee_heures\": 10\n}"
        },
        "url": {
          "raw": "{{baseUrl}}{{apiPrefix}}/learning/parcours",
          "host": ["{{baseUrl}}"],
          "path": ["{{apiPrefix}}", "learning", "parcours"]
        },
        "description": "Création d'un parcours d'apprentissage"
      },
      "response": []
    },
