### 7. Créer une simulation d'attaque phishing
POST {{baseUrl}}/learning/media
Content-Type: application/json
Authorization: Bearer {{superadmin_token}}

{
  "module_id": 2,
  "titre": "Simulation d'Attaque Phishing",
  "type_contenu": "simulation",
  "duree_minutes": 25,
  "nom_fichier": "simulation-phishing.json",
  "taille_fichier": 8192,
  "description": "Simulation interactive d'une tentative de phishing pour entraîner la détection",
  "contenu": "{\"scenario\": \"email_urgent\", \"etapes\": [{\"etape\": 1, \"action\": \"reception_email\", \"contenu\": \"Votre compte bancaire a été suspendu. Cliquez ici pour le réactiver immédiatement.\", \"signes_suspects\": [\"urgence\", \"lien_suspect\", \"demande_action\"]}, {\"etape\": 2, \"action\": \"verification_url\", \"url\": \"http://fake-bank-secure.com\", \"signes_suspects\": [\"http_au_lieu_de_https\", \"domaine_suspect\"]}, {\"etape\": 3, \"action\": \"demande_informations\", \"champs\": [\"numero_carte\", \"code_secret\", \"date_expiration\"], \"signes_suspects\": [\"demande_informations_sensibles\"]}]}",
  "type_attaque": "phishing_email"
}

