### 12. Créer un contenu interactif avancé
POST {{baseUrl}}/learning/media
Content-Type: application/json
Authorization: Bearer {{superadmin_token}}

{
  "module_id": 5,
  "titre": "Simulation Sécurité Mobile",
  "type_contenu": "interactif",
  "duree_minutes": 35,
  "nom_fichier": "simulation-securite-mobile.json",
  "taille_fichier": 12288,
  "description": "Simulation interactive sur la sécurité mobile avec scénarios réalistes",
  "contenu": "{\"scenarios\": [{\"id\": 1, \"titre\": \"WiFi public\", \"situation\": \"Vous êtes dans un café et devez vous connecter à Internet\", \"options\": [{\"texte\": \"Se connecter au WiFi public gratuit\", \"consequence\": \"Risque d'interception des données\", \"score\": -10}, {\"texte\": \"Utiliser votre hotspot mobile\", \"consequence\": \"Connexion sécurisée\", \"score\": 10}, {\"texte\": \"Utiliser un VPN sur le WiFi public\", \"consequence\": \"Connexion sécurisée\", \"score\": 8}], \"explication\": \"Les réseaux WiFi publics sont souvent non sécurisés et peuvent exposer vos données.\"}, {\"id\": 2, \"titre\": \"Application suspecte\", \"situation\": \"Une application vous demande l'accès à vos contacts\", \"options\": [{\"texte\": \"Accepter pour utiliser l'app\", \"consequence\": \"Données personnelles exposées\", \"score\": -15}, {\"texte\": \"Refuser et chercher une alternative\", \"consequence\": \"Protection de la vie privée\", \"score\": 15}, {\"texte\": \"Vérifier les permissions nécessaires\", \"consequence\": \"Décision éclairée\", \"score\": 12}], \"explication\": \"Vérifiez toujours pourquoi une application demande des permissions.\"}]}",
  "type_attaque": "fake_app"
}

