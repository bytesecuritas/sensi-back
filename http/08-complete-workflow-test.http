Content-Type: {{contentType}}
Authorization: Bearer {{user1_token}}

{
  "quiz_id": 3,
  "reponses": [
    { "question_id": 5, "reponse_vrai_faux": false },
    { "question_id": 6, "reponse_texte": "gestionnaire" }
  ],
  "temps_total_secondes": 110
}

