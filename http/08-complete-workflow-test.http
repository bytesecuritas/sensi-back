### 16. Créer un quiz final de parcours (type = parcours_final)
POST {{baseUrl}}/learning/quizzes/parcours_final/parent/1
Content-Type: {{contentType}}
Authorization: Bearer {{superadmin_token}}

{
  "titre": "Quiz Final - Sensibilisation",
  "description": "Évaluation finale (80% requis)",
  "questions": [
    {
      "enonce": "Le MFA améliore la sécurité (Vrai/Faux)",
      "type_question": "vrai_faux",
      "ordre": 1,
      "reponses": [
        { "texte": "Vrai", "est_correcte": true, "ordre": 1 },
        { "texte": "Faux", "est_correcte": false, "ordre": 2 }
      ]
    },
    {
      "enonce": "Bonne pratique essentielle (texte)",
      "type_question": "texte_libre",
      "ordre": 2,
      "reponses": [
        { "texte": "mfa", "est_correcte": true, "ordre": 1 },
        { "texte": "gestionnaire", "est_correcte": true, "ordre": 2 }
      ]
    }
  ]
}

