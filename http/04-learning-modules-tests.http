  "public_cible": "avance",
  "code_langue": "FR",
  "niveau_difficulte": "difficile",
  "thematique_cyber": "ransomware",
  "objectifs_apprentissage": [
    "Comprendre le fonctionnement des rançongiciels",
    "Identifier les vecteurs d'attaque",
