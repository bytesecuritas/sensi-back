### Test 3: Créer un quiz avec seulement des questions à réponse libre
POST {{baseUrl}}/learning/modules/1/quizzes
Content-Type: {{contentType}}
Authorization: Bearer {{superadmin_token}}

{
  "titre": "Quiz réflexion sur la cybersécurité",
  "description": "Questions ouvertes pour tester la compréhension",
  "ordre": 3,
  "actif": true,
  "questions": [
    {
      "enonce": "Expliquez pourquoi il est important de ne pas réutiliser les mêmes mots de passe.",
      "type_question": "texte_libre",
      "ordre": 1,
      "points": 20.0,
      "termes": ["gestionnaire", "unique", "ne pas reutiliser"],
      "explication": "La réutilisation de mots de passe multiplie les risques"
    },
    {
      "enonce": "Décrivez les étapes que vous suivriez si vous receviez un email suspect.",
      "type_question": "texte_libre",
      "ordre": 2,
      "points": 20.0,
      "termes": ["ne pas cliquer", "signaler", "vérifier l'url", "contacter it"],
      "explication": "Il faut toujours être prudent avec les emails suspects"
    },
    {
      "enonce": "Quelles mesures de sécurité mettriez-vous en place pour protéger votre ordinateur personnel ?",
      "type_question": "texte_libre",
      "ordre": 3,
      "points": 20.0,
      "termes": ["antivirus", "pare-feu", "mises à jour", "mots de passe forts"],
      "explication": "Plusieurs mesures sont nécessaires pour une protection complète"
    }
  ]
}

