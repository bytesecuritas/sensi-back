### Test 2: Créer un quiz simple avec seulement des questions à choix unique
POST {{baseUrl}}/learning/modules/1/quizzes
Content-Type: {{contentType}}
Authorization: Bearer {{superadmin_token}}

{
  "titre": "Quiz simple sur les mots de passe",
  "description": "Quiz basique sur la sécurité des mots de passe",
  "ordre": 2,
  "actif": true,
  "questions": [
    {
      "enonce": "Quelle est la longueur minimale recommandée pour un mot de passe ?",
      "type_question": "choix_unique",
      "ordre": 1,
      "points": 10.0,
      "reponses": [
        {
          "texte": "4 caractères",
          "est_correcte": false,
          "ordre": 1
        },
        {
          "texte": "8 caractères",
          "est_correcte": false,
          "ordre": 2
        },
        {
          "texte": "12 caractères",
          "est_correcte": true,
          "ordre": 3
        },
        {
          "texte": "16 caractères",
          "est_correcte": false,
          "ordre": 4
        }
      ]
    },
    {
      "enonce": "Quel élément NE devrait PAS être inclus dans un mot de passe ?",
      "type_question": "choix_unique",
      "ordre": 2,
      "points": 10.0,
      "reponses": [
        {
          "texte": "Lettres majuscules",
          "est_correcte": false,
          "ordre": 1
        },
        {
          "texte": "Chiffres",
          "est_correcte": false,
          "ordre": 2
        },
        {
          "texte": "Symboles",
          "est_correcte": false,
          "ordre": 3
        },
        {
          "texte": "Nom de votre chien",
          "est_correcte": true,
          "ordre": 4
        }
      ]
    }
  ]
}

