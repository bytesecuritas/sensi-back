### Test 8: Soumettre les réponses au quiz à réponse libre
POST {{baseUrl}}/learning/quizzes/3/submit
Content-Type: {{contentType}}
Authorization: Bearer {{superadmin_token}}

{
  "quiz_id": 3,
  "reponses": [
    {
      "question_id": 1,
      "reponse_texte": "Si un compte est compromis, les autres comptes restent sécurisés car ils utilisent des mots de passe différents. Cela limite les dégâts en cas de fuite de données."
    },
    {
      "question_id": 2,
      "reponse_texte": "Je ne cliquerais pas sur les liens, vérifierais l'expéditeur, ne téléchargerais pas de pièces jointes suspectes et signalerais l'email comme spam."
    },
    {
      "question_id": 3,
      "reponse_texte": "J'installerais un antivirus, activerais le pare-feu, ferais des mises à jour régulières, utiliserais des mots de passe forts et ferais des sauvegardes."
    }
  ],
  "temps_total_secondes": 600
}

