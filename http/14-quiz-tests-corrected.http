### ========================================
### 1. CRÉATION DE QUIZ AVEC QUESTIONS CORRIGÉES
### ========================================

### Test 1: Créer un quiz avec tous les types de questions
POST {{baseUrl}}/learning/modules/1/quizzes
Content-Type: {{contentType}}
Authorization: Bearer {{superadmin_token}}

{
  "titre": "Quiz sur la cybersécurité",
  "description": "Testez vos connaissances en cybersécurité",
  "ordre": 1,
  "actif": true,
  "temps_limite_minutes": 15,
  "score_minimum_pour_reussite": 70.0,
  "questions": [
    {
      "enonce": "Qu'est-ce que le phishing ?",
      "type_question": "choix_unique",
      "ordre": 1,
      "points": 10.0,
      "explication": "Le phishing est une technique d'ingénierie sociale",
      "reponses": [
        {
          "texte": "Une technique d'ingénierie sociale pour voler des informations",
          "est_correcte": true,
          "ordre": 1
        },
        {
          "texte": "Un type de virus informatique",
          "est_correcte": false,
          "ordre": 2
        },
        {
          "texte": "Un protocole de sécurité",
          "est_correcte": false,
          "ordre": 3
        },
        {
          "texte": "Un logiciel antivirus",
          "est_correcte": false,
          "ordre": 4
        }
      ]
    },
    {
      "enonce": "Quelles sont les bonnes pratiques pour un mot de passe sécurisé ?",
      "type_question": "choix_multiple",
      "ordre": 2,
      "points": 15.0,
      "explication": "Un mot de passe sécurisé doit respecter plusieurs critères",
      "reponses": [
        {
          "texte": "Utiliser au moins 12 caractères",
          "est_correcte": true,
          "ordre": 1
        },
        {
          "texte": "Inclure des majuscules et minuscules",
          "est_correcte": true,
          "ordre": 2
        },
        {
          "texte": "Inclure des chiffres et symboles",
          "est_correcte": true,
          "ordre": 3
        },
        {
          "texte": "Utiliser des informations personnelles",
          "est_correcte": false,
          "ordre": 4
        },
        {
          "texte": "Réutiliser le même mot de passe partout",
          "est_correcte": false,
          "ordre": 5
        }
      ]
    },
    {
      "enonce": "Il est sécurisé de cliquer sur tous les liens reçus par email.",
      "type_question": "vrai_faux",
      "ordre": 3,
      "points": 5.0,
      "explication": "Il faut toujours vérifier la source avant de cliquer",
      "reponses": [
        {
          "texte": "Vrai",
          "est_correcte": false,
          "ordre": 1
        },
        {
          "texte": "Faux",
          "est_correcte": true,
          "ordre": 2
        }
      ]
    },
    {
      "enonce": "Décrivez comment vous protégeriez vos données personnelles en ligne.",
      "type_question": "texte_libre",
      "ordre": 4,
      "points": 10.0,
      "termes": ["ne pas partager", "mfa", "2fa", "vpn", "mots de passe forts"],
      "explication": "La protection des données personnelles est essentielle"
    }
  ]
}

