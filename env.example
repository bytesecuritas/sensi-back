# Configuration JWT - CHANGEZ CES VALEURS EN PRODUCTION
# La clé secrète doit faire au moins 32 caractères
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-must-be-at-least-32-characters-long

# Configuration de la base de données
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=sensibilisation

# Configuration du serveur
PORT=3000

# Configuration de sécurité
NODE_ENV=development

# Instructions :
# 1. Copiez ce fichier vers .env
# 2. Modifiez les valeurs selon votre environnement
# 3. En production, utilisez une clé JWT_SECRET forte et unique
# 4. Ne committez jamais le fichier .env dans git
